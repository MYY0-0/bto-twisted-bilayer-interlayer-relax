#delete_atoms overlap 1.0 all all
neighbor 2.0 bin
neigh_modify delay 10 check yes


# ------------------------- compute properties----------------------------
compute eng all pe/atom
compute 1 all ke/atom
compute eatoms all reduce sum c_eng
#compute strs all stress/atom NULL virial

#------------------------- Minimization ------------------------
reset_timestep 0
timestep  0.001

thermo     10
thermo_style   custom step pe fmax fnorm lx ly lz press pxx pyy pzz
thermo_modify  lost ignore flush yes
write_dump      all custom BTO_before_relax.xyz id type x y z modify sort id
